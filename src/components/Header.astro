---
import wordmark from '../assets/brand/trasio-wordmark-on-dark.svg';
import {
  APP_URL,
  localeNames,
  localePath,
  locales,
  switchLocalePath,
  useTranslations,
  type Locale,
} from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;
const links = [
  { href: localePath(lang, '#features'), label: t('nav.features') },
  { href: localePath(lang, 'guide/'), label: t('nav.guide') },
  { href: localePath(lang, 'licenses/'), label: t('nav.licenses') },
];
const others = (locales as Locale[]).filter((l) => l !== lang);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localePath(lang)}>
      <img src={wordmark.src} width="120" height="35" alt="Trasio" />
      <span class="tagline">{t('site.tagline')}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">{t('nav.menu')}</span>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg
      >
    </button>
    <nav class="nav" id="site-nav" aria-label={t('nav.menu')}>
      {
        links.map((l) => (
          <a href={l.href} aria-current={path.startsWith(l.href) && !l.href.includes('#') ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <span class="langs" aria-label={t('nav.language')}>
        {
          others.map((l) => (
            <a href={switchLocalePath(path, l)} hreflang={l} lang={l}>
              {localeNames[l]}
            </a>
          ))
        }
      </span>
      <a class="btn btn-primary" href={APP_URL}>{t('nav.open')}</a>
    </nav>
  </div>
</header>

<script>
  // Phone menu: the button shows and hides the navigation.
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header {
    background: var(--color-forest);
    color: var(--color-forest-text);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
    gap: 16px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    color: inherit;
  }

  .brand img {
    width: 110px;
    height: auto;
  }

  .tagline {
    font-size: 0.72rem;
    opacity: 0.8;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 8px;
    color: var(--color-on-forest);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav a:not(.btn) {
    color: var(--color-forest-text);
    text-decoration: none;
    font-weight: 500;
  }

  .nav a:not(.btn):hover,
  .nav a[aria-current='page'] {
    color: #fff;
  }

  .langs {
    display: flex;
    gap: 12px;
    padding-left: 16px;
    border-left: 1px solid var(--color-forest-active);
    font-size: 0.9rem;
  }

  .nav .btn {
    padding: 9px 16px;
  }

  @media (max-width: 820px) {
    .menu-toggle {
      display: block;
    }

    .nav {
      display: none;
    }

    .menu-toggle[aria-expanded='true'] + .nav {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      position: absolute;
      left: 0;
      right: 0;
      top: 68px;
      background: var(--color-forest);
      padding: 8px var(--gutter) 20px;
      border-top: 1px solid var(--color-forest-active);
    }

    .menu-toggle[aria-expanded='true'] + .nav a:not(.btn) {
      padding: 10px 0;
    }

    .langs {
      border-left: 0;
      padding: 0;
    }

    .nav .btn {
      justify-content: center;
      margin-top: 8px;
    }
  }
</style>
