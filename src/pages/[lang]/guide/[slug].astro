---
import { render } from 'astro:content';
import Copy from '@lucide/astro/icons/copy';
import Check from '@lucide/astro/icons/check';
import Base from '../../../layouts/Base.astro';
import { guideIn, splitId } from '../../../i18n/content';
import { localePath, locales, useTranslations, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const perLang = await Promise.all(
    (locales as Locale[]).map(async (lang) => {
      const pages = await guideIn(lang);
      return pages.map((entry, i) => ({
        params: { lang, slug: splitId(entry.id).slug },
        props: { entry, prev: pages[i - 1], next: pages[i + 1], all: pages },
      }));
    }),
  );
  return perLang.flat();
}

const { entry, prev, next, all } = Astro.props;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { Content } = await render(entry);
const href = (e: { id: string }) => localePath(lang, `guide/${splitId(e.id).slug}/`);
---

<Base lang={lang} title={`${entry.data.title} · ${t('guide.title')} · Trasio`} description={entry.data.description}>
  <div class="container layout">
    <aside>
      <nav aria-label={t('guide.contents')}>
        <a class="back" href={localePath(lang, 'guide/')}>{t('guide.title')}</a>
        <ol>
          {
            all.map((e) => (
              <li>
                <a href={href(e)} aria-current={e.id === entry.id ? 'page' : undefined}>
                  {e.data.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>
    <article class="prose">
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <Content />
      <!-- Icons for the copy buttons that the script below adds to code blocks. -->
      <template id="copy-icons">
        <Copy size={16} aria-hidden="true" class="icon-copy" />
        <Check size={16} aria-hidden="true" class="icon-done" />
      </template>
      <nav class="pager">
        {prev && <a href={href(prev)}>← {prev.data.title}</a>}
        {next && <a class="next" href={href(next)}>{next.data.title} →</a>}
      </nav>
    </article>
  </div>
</Base>

<script is:inline define:vars={{ copyLabel: t('guide.copy'), copiedLabel: t('guide.copied') }}>
  // Copy button on every code block: copies the code text to the clipboard.
  const icons = document.getElementById('copy-icons');
  document.querySelectorAll('.prose pre').forEach((pre) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-btn';
    button.title = copyLabel;
    button.setAttribute('aria-label', copyLabel);
    button.append(icons.content.cloneNode(true));
    button.addEventListener('click', async () => {
      try {
        // Without the last line break, so a pasted command does not run at once.
        const code = pre.querySelector('code') ?? pre;
        await navigator.clipboard.writeText(code.textContent.trimEnd());
      } catch {
        return;
      }
      button.classList.add('done');
      button.title = copiedLabel;
      button.setAttribute('aria-label', copiedLabel);
      setTimeout(() => {
        button.classList.remove('done');
        button.title = copyLabel;
        button.setAttribute('aria-label', copyLabel);
      }, 2000);
    });
    // The button sits in a wrapper, so it stays in the corner when a long
    // line scrolls sideways.
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.before(wrapper);
    wrapper.append(pre, button);
  });
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 48px;
    padding-top: 48px;
    padding-bottom: 96px;
  }

  aside nav {
    position: sticky;
    top: 96px;
  }

  aside ol {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
  }

  aside li a {
    display: block;
    padding: 6px 12px;
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  aside li a:hover {
    background: var(--color-primary-light);
  }

  aside li a[aria-current='page'] {
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-weight: 600;
  }

  .back {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .pager .next {
    margin-left: auto;
  }

  @media (max-width: 820px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    aside nav {
      position: static;
    }
  }
</style>
