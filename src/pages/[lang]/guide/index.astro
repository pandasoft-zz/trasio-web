---
import Base from '../../../layouts/Base.astro';
import { guideIn, splitId } from '../../../i18n/content';
import { langPaths, localePath, useTranslations, type Locale } from '../../../i18n/ui';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const pages = await guideIn(lang);
---

<Base lang={lang} title={`${t('guide.title')} · Trasio`} description={t('guide.lead')}>
  <div class="container page-head">
    <h1>{t('guide.title')}</h1>
    <p class="lead">{t('guide.lead')}</p>
  </div>
  <div class="container">
    <ol class="list">
      {
        pages.map((p, i) => (
          <li>
            <a class="card item" href={localePath(lang, `guide/${splitId(p.id).slug}/`)}>
              <span class="no">{i + 1}</span>
              <span>
                <strong>{p.data.title}</strong>
                <span class="desc">{p.data.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0 0 96px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }

  .item {
    display: flex;
    gap: 16px;
    padding: 20px;
    height: 100%;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .item:hover {
    color: inherit;
    border-color: var(--color-primary);
  }

  .item strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin-bottom: 4px;
  }

  .desc {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .no {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }
</style>
