---
import { Image } from 'astro:assets';
import CalendarRange from '@lucide/astro/icons/calendar-range';
import MapPin from '@lucide/astro/icons/map-pin';
import Route from '@lucide/astro/icons/route';
import Check from '@lucide/astro/icons/check';
import Watch from '@lucide/astro/icons/watch';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Base from '../../layouts/Base.astro';
import JourneyBar from '../../components/JourneyBar.astro';
import { APP_URL, langPaths, localePath, useTranslations, type Locale, type UiKey } from '../../i18n/ui';
import webConnections from '../../assets/screens/web-connections.jpg';
import webMap from '../../assets/screens/web-map.jpg';
import tripDetail from '../../assets/screens/design-trip-detail.jpg';
import stagePoints from '../../assets/screens/design-stage-points.png';
import mobileConnections from '../../assets/screens/mobile-connections.png';
import androidPlace from '../../assets/screens/design-android-place.png';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const pillars = [
  { icon: CalendarRange, key: 'plan', href: '#plan', main: true },
  { icon: MapPin, key: 'places', href: '#places', main: false },
  { icon: Route, key: 'journeys', href: '#journeys', main: false },
] as const;

const planBullets = ['b1', 'b2', 'b3', 'b4', 'b5', 'b6'].map((b) => `home.plan.${b}` as UiKey);
const placeBullets = ['b1', 'b2', 'b3', 'b4'].map((b) => `home.places.${b}` as UiKey);
const journeyBullets = ['b1', 'b2', 'b3'].map((b) => `home.journeys.${b}` as UiKey);
const androidBullets = ['b1', 'b2', 'b3'].map((b) => `home.android.${b}` as UiKey);
const steps = [1, 2, 3, 4] as const;
---

<Base lang={lang} title={t('home.title')}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <span class="eyebrow">{t('home.hero.eyebrow')}</span>
        <h1>{t('home.hero.title')}</h1>
        <p class="lead">{t('home.hero.lead')}</p>
        <div class="actions">
          <a class="btn btn-primary" href={APP_URL}>{t('home.hero.cta')} <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="btn btn-ghost" href="#features">{t('home.hero.secondary')}</a>
        </div>
        <p class="note">{t('home.hero.note')}</p>
      </div>
      <div class="hero-shot">
        <Image
          src={webMap}
          alt={t('home.hero.alt')}
          widths={[640, 960, 1440, 2000]}
          sizes="(max-width: 960px) 100vw, 640px"
          class="shot"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="section" id="features">
    <div class="container">
      <div class="section-head">
        <h2>{t('home.pillars.title')}</h2>
        <p class="lead">{t('home.pillars.lead')}</p>
      </div>
      <ul class="pillars">
        {
          pillars.map(({ icon: Icon, key, href, main }) => (
            <li>
              <a class:list={['card', 'pillar', { main }]} href={href}>
                <span class="pillar-icon">
                  <Icon size={24} aria-hidden="true" />
                </span>
                {main && <span class="pillar-badge">{t('home.pillar.plan.badge')}</span>}
                <h3>{t(`home.pillar.${key}.title`)}</h3>
                <p>{t(`home.pillar.${key}.text`)}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section feature" id="plan">
    <div class="container feature-grid">
      <div>
        <span class="eyebrow">{t('home.plan.eyebrow')}</span>
        <h2>{t('home.plan.title')}</h2>
        <p class="lead">{t('home.plan.text')}</p>
        <ul class="checks">
          {
            planBullets.map((k) => (
              <li>
                <Check size={18} aria-hidden="true" />
                {t(k)}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="stack">
        <Image src={tripDetail} alt={t('home.plan.alt')} widths={[640, 925]} sizes="(max-width: 960px) 100vw, 620px" class="shot" />
        <Image
          src={stagePoints}
          alt={t('home.plan.altPoints')}
          widths={[300, 600]}
          sizes="280px"
          class="shot stack-over"
        />
      </div>
    </div>
  </section>

  <section class="section feature places" id="places">
    <div class="container feature-grid reverse">
      <div>
        <span class="eyebrow">{t('home.places.eyebrow')}</span>
        <h2>{t('home.places.title')}</h2>
        <p class="lead">{t('home.places.text')}</p>
        <ul class="checks">
          {
            placeBullets.map((k) => (
              <li>
                <Check size={18} aria-hidden="true" />
                {t(k)}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="phones">
        <Image src={androidPlace} alt={t('home.places.alt')} widths={[280, 560]} sizes="280px" class="phone" />
      </div>
    </div>
  </section>

  <section class="section feature dark" id="journeys">
    <div class="container feature-grid">
      <div>
        <span class="eyebrow">{t('home.journeys.eyebrow')}</span>
        <h2>{t('home.journeys.title')}</h2>
        <p class="lead">{t('home.journeys.text')}</p>
        <ul class="checks">
          {
            journeyBullets.map((k) => (
              <li>
                <Check size={18} aria-hidden="true" />
                {t(k)}
              </li>
            ))
          }
        </ul>
        <JourneyBar />
      </div>
      <Image
        src={webConnections}
        alt={t('home.journeys.alt')}
        widths={[640, 1280, 2000]}
        sizes="(max-width: 960px) 100vw, 620px"
        class="shot"
      />
    </div>
  </section>

  <section class="section" id="how">
    <div class="container">
      <div class="section-head">
        <h2>{t('home.together.title')}</h2>
        <p class="lead">{t('home.together.lead')}</p>
      </div>
      <ol class="steps">
        {
          steps.map((n) => (
            <li>
              <span class="step-no">{n}</span>
              <h3>{t(`home.step${n}.title`)}</h3>
              <p>{t(`home.step${n}.text`)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section feature dark">
    <div class="container feature-grid reverse">
      <div>
        <span class="badge">{t('home.android.badge')}</span>
        <h2>{t('home.android.title')}</h2>
        <p class="lead">{t('home.android.text')}</p>
        <ul class="checks">
          {
            androidBullets.map((k) => (
              <li>
                <Check size={18} aria-hidden="true" />
                {t(k)}
              </li>
            ))
          }
        </ul>
        <p class="wearables">
          <Watch size={20} aria-hidden="true" />
          <span>{t('home.android.wearables')}</span>
        </p>
      </div>
      <div class="phones">
        <Image src={mobileConnections} alt={t('home.android.altWeb')} widths={[280, 560]} sizes="280px" class="phone" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container open card">
      <div>
        <h2>{t('home.open.title')}</h2>
        <p>{t('home.open.text')}</p>
      </div>
      <a class="btn btn-ghost" href={localePath(lang, 'licenses/')}>{t('home.open.link')}</a>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>{t('home.cta.title')}</h2>
      <p>{t('home.cta.text')}</p>
      <a class="btn btn-primary" href={APP_URL}>{t('home.hero.cta')} <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--color-forest);
    color: var(--color-on-forest);
    padding: 56px 0 80px;
    overflow: hidden;
  }

  .hero-grid,
  .feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 48px;
    align-items: center;
  }

  .hero h1 {
    color: #fff;
  }

  .hero .lead {
    color: var(--color-forest-text);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0 12px;
  }

  .note {
    font-size: 0.9rem;
    color: var(--color-forest-text);
    opacity: 0.85;
  }

  .hero-shot :global(img) {
    border-color: var(--color-forest-active);
  }

  /* Three pillars; the first one (trip planning) is the main one. */
  .pillars {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 20px;
  }

  .pillar {
    display: block;
    height: 100%;
    padding: 28px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  .pillar:hover {
    color: inherit;
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .pillar p {
    color: var(--color-text-secondary);
    margin: 0;
  }

  .pillar.main {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-on-forest);
  }

  .pillar.main h3 {
    color: #fff;
    font-size: 1.4rem;
  }

  .pillar.main p {
    color: var(--color-forest-text);
  }

  .pillar-icon {
    display: inline-flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: var(--color-primary-light);
    color: var(--color-primary);
    margin-bottom: 16px;
  }

  .pillar.main .pillar-icon {
    background: var(--color-accent);
    color: #fff;
  }

  .pillar-badge {
    display: inline-block;
    margin-left: 12px;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-forest-active);
    font-size: 0.8rem;
    font-weight: 600;
    vertical-align: super;
  }

  .feature .reverse > div:first-child {
    order: 2;
  }

  .places {
    background: var(--color-primary-light);
  }

  .dark {
    background: var(--color-forest);
    color: var(--color-on-forest);
  }

  .dark h2 {
    color: #fff;
  }

  .dark .lead,
  .dark .checks {
    color: var(--color-forest-text);
  }

  .dark :global(.shot) {
    border-color: var(--color-forest-active);
  }

  .checks {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    gap: 10px;
    color: var(--color-text-secondary);
  }

  .checks li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .checks :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--color-accent);
  }

  /* Trip detail with the stage points card over its corner. */
  .stack {
    position: relative;
    padding-bottom: 80px;
  }

  .stack :global(.stack-over) {
    position: absolute;
    right: -16px;
    bottom: 0;
    width: min(240px, 42%);
  }

  .phones {
    display: flex;
    justify-content: center;
  }

  .phones :global(.phone) {
    width: min(280px, 70%);
    border-radius: 28px;
    border: 6px solid #0d1a12;
    box-shadow: var(--shadow-float);
    background: #fff;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .steps p {
    color: var(--color-text-secondary);
  }

  .step-no {
    display: inline-flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    margin-bottom: 12px;
    box-shadow: 0 0 0 4px #fff;
  }

  .badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-forest-active);
    color: var(--color-on-forest);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .wearables {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-top: 28px;
    padding: 14px 16px;
    border: 1px solid var(--color-forest-active);
    border-radius: var(--radius-md);
    color: var(--color-forest-text);
    font-size: 0.95rem;
  }

  .wearables :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--color-accent);
  }

  .open {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 32px;
  }

  .open p {
    margin: 0;
    color: var(--color-text-secondary);
    max-width: 60ch;
  }

  .open .btn {
    color: var(--color-primary);
  }

  .cta {
    text-align: center;
    padding: 0 0 clamp(56px, 8vw, 96px);
  }

  .cta p {
    color: var(--color-text-secondary);
  }

  @media (max-width: 960px) {
    .hero-grid,
    .feature-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .feature .reverse > div:first-child {
      order: 0;
    }

    .pillars {
      grid-template-columns: 1fr;
    }

    .steps {
      grid-template-columns: 1fr 1fr;
    }

    .stack :global(.stack-over) {
      right: 0;
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
