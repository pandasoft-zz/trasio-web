---
// One version of a legal document at its permanent address:
// /<lang>/legal/<doc>/<valid-from>/. The text of a published version never
// changes (ADR 002), so this page always shows what a user accepted.
import LegalPage from '../../../../components/LegalPage.astro';
import { legalDocsIn, legalId } from '../../../../i18n/legal';
import { locales, type Locale } from '../../../../i18n/ui';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales as Locale[]) {
    for (const [doc, versions] of await legalDocsIn(lang)) {
      for (const entry of versions) {
        paths.push({ params: { lang, doc, version: legalId(entry).version }, props: { entry, versions } });
      }
    }
  }
  return paths;
}

const lang = Astro.params.lang as Locale;
const { entry, versions } = Astro.props;
---

<LegalPage lang={lang} entry={entry} versions={versions} />
